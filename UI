local function BuildKeySystem(cfg, hui, onSuccess, onClose)
    cfg = cfg or {}

    local WIN_W      = 400
    local showShop   = cfg.Shop and cfg.Shop.Enabled
    local shopH      = showShop and 53 or 0
    local WIN_H      = 360 + shopH
    local HEADER_H   = 52
    local STATUS_H   = 60
    local ELEM_H     = 56
    local BUTTON_H   = 42
    local UINFO_W    = 180
    local CLOG_W     = 220
    local GAP        = 12

    -- Blur
    local blur = Instance.new("BlurEffect")
    blur.Size = 0
    blur.Parent = game:GetService("Lighting")
    tw(blur, {Size=20}, 0.4)

    -- Root layer
    local layer = mkFrame(hui, BG, UDim2.new(1,0,1,0))
    layer.BackgroundTransparency = 1

    -- Main frame
    local main = mkFrame(layer, BG,
        UDim2.new(0,WIN_W,0,WIN_H),
        UDim2.new(0.5,0,0.5,0), Vector2.new(0.5,0.5))
    corner(main, 10)
    uiStroke(main, DIVIDER, 1, 0.5)
    main.ClipsDescendants = false
    makeDrag(main, main)

    -- Entrance anim
    main.BackgroundTransparency = 0.3
    main.Size = UDim2.new(0, WIN_W*0.88, 0, WIN_H*0.88)
    tw(main, {BackgroundTransparency=0, Size=UDim2.new(0,WIN_W,0,WIN_H)}, 0.4)

    local function closeUI(cb)
        tw(blur, {Size=0}, 0.3)
        tw(main, {BackgroundTransparency=1,
            Size=UDim2.new(0,WIN_W*0.88,0,WIN_H*0.88)}, 0.3)
        task.delay(0.35, function()
            blur:Destroy()
            layer:Destroy()
            if cb then cb() end
        end)
    end

    -- Header
    local hdr = mkFrame(main, HEADER, UDim2.new(1,0,0,HEADER_H))
    corner(hdr, 10)
    mkFrame(hdr, HEADER, UDim2.new(1,0,0,10), UDim2.new(0,0,1,-10))

    local iconImg = Instance.new("ImageLabel")
    iconImg.Size = UDim2.new(0,26,0,26)
    iconImg.Position = UDim2.new(0,14,0.5,0)
    iconImg.AnchorPoint = Vector2.new(0,0.5)
    iconImg.BackgroundTransparency = 1
    iconImg.Image = cfg.Icon or ""
    iconImg.ImageColor3 = ACCENT
    iconImg.Parent = hdr

    local titleL = mkLabel(hdr, cfg.Title or "PuppyWare", 15, TEXT, FONT_BOLD,
        UDim2.new(0, cfg.Icon ~= "" and 46 or 14, 0.5, -9))
    titleL.Size = UDim2.new(1,-110,0,18)

    local subL = mkLabel(hdr, cfg.Subtitle or "Enter your key to continue", 11, DIM, FONT,
        UDim2.new(0, cfg.Icon ~= "" and 46 or 14, 0.5, 7))
    subL.Size = UDim2.new(1,-110,0,14)

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0,28,0,28)
    closeBtn.Position = UDim2.new(1,-12,0.5,0)
    closeBtn.AnchorPoint = Vector2.new(1,0.5)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = DIM
    closeBtn.Font = FONT_BOLD
    closeBtn.TextSize = 13
    closeBtn.Parent = hdr
    closeBtn.MouseEnter:Connect(function() closeBtn.TextColor3 = TEXT end)
    closeBtn.MouseLeave:Connect(function() closeBtn.TextColor3 = DIM end)
    closeBtn.MouseButton1Click:Connect(function()
        closeUI(onClose)
    end)

    -- Shared panels (always created)
    local _, clogToggle, clogIsOpen, clogRefresh =
        CreateChangelogPanel(main, WIN_H, CLOG_W, GAP)
    local _, userToggle, userIsOpen =
        CreateUserInfoPanel(main, WIN_H, UINFO_W, GAP)

    if cfg.Changelog then clogRefresh(cfg.Changelog) end

    -- Icon button helper
    local function mkIconBtn(parent, ico, xOff)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0,36,0,36)
        btn.Position = UDim2.new(0.5,xOff,0,0)
        btn.AnchorPoint = Vector2.new(0.5,0)
        btn.BackgroundColor3 = INPUT
        btn.Text = ico
        btn.TextColor3 = DIM
        btn.Font = FONT_BOLD
        btn.TextSize = 14
        btn.Parent = parent
        corner(btn, 8)
        uiStroke(btn, DIVIDER, 1, 0.5)
        btn.MouseEnter:Connect(function() tw(btn,{BackgroundColor3=HEADER},0.1) end)
        btn.MouseLeave:Connect(function() tw(btn,{BackgroundColor3=INPUT},0.1) end)
        return btn
    end

    -- Content area
    local contentH = WIN_H - HEADER_H - shopH
    local content = mkFrame(main, BG,
        UDim2.new(1,0,0,contentH),
        UDim2.new(0,0,0,HEADER_H))

    -- ══════════════════════════════════
    -- STATE: KEYLESS
    -- ══════════════════════════════════
    if cfg.Keyless == true then
        -- Success box
        local sbox = mkFrame(content, SUCCESS,
            UDim2.new(1,-32,0,STATUS_H),
            UDim2.new(0.5,0,0,8), Vector2.new(0.5,0))
        sbox.BackgroundTransparency = 0.85
        corner(sbox, 8)
        uiStroke(sbox, SUCCESS, 1, 0.5)

        local chkL = mkLabel(sbox, "✓", 20, SUCCESS, FONT_BOLD,
            UDim2.new(0,14,0.5,0), Vector2.new(0,0.5))
        chkL.Size = UDim2.new(0,30,1,0)
        chkL.TextXAlignment = Enum.TextXAlignment.Center

        local agL = mkLabel(sbox, "Access Granted", 14, SUCCESS, FONT_BOLD,
            UDim2.new(0,50,0,0))
        agL.Size = UDim2.new(1,-64,0.56,0)

        local ksL = mkLabel(sbox, "Keyless Script", 11, DIM, FONT,
            UDim2.new(0,50,0.56,0))
        ksL.Size = UDim2.new(1,-64,0.44,0)

        -- Divider
        mkFrame(content, DIVIDER,
            UDim2.new(1,-32,0,1),
            UDim2.new(0.5,0,0,78), Vector2.new(0.5,0))

        -- Launch button
        local launchBtn = Instance.new("TextButton")
        launchBtn.Size = UDim2.new(0, WIN_W*0.72, 0, BUTTON_H)
        launchBtn.Position = UDim2.new(0.5,0,0,90)
        launchBtn.AnchorPoint = Vector2.new(0.5,0)
        launchBtn.BackgroundColor3 = ACCENT
        launchBtn.Text = "Launch Script"
        launchBtn.TextColor3 = TEXT
        launchBtn.Font = FONT_BOLD
        launchBtn.TextSize = 14
        launchBtn.Parent = content
        corner(launchBtn, 8)
        launchBtn.MouseEnter:Connect(function() tw(launchBtn,{BackgroundColor3=ACCENT_HOVER},0.12) end)
        launchBtn.MouseLeave:Connect(function() tw(launchBtn,{BackgroundColor3=ACCENT},0.12) end)
        launchBtn.MouseButton1Click:Connect(function()
            getgenv().SCRIPT_KEY = "KEYLESS"
            closeUI(onSuccess)
        end)

        -- Icon row
        local iconRow = mkFrame(content, BG,
            UDim2.new(1,-32,0,36),
            UDim2.new(0.5,0,0,148), Vector2.new(0.5,0))
        iconRow.BackgroundTransparency = 1

        local uIco = mkIconBtn(iconRow, "👤", -44)
        local dIco = mkIconBtn(iconRow, "⬡",   0)
        local cIco = mkIconBtn(iconRow, "↻",   44)

        uIco.MouseButton1Click:Connect(function() userToggle() end)
