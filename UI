        function TabAPI:Toggle(text, desc, default, callback)
            local el    = elem(44)
            local state = default == true
            local l = mkLabel(el, text, 13, TEXT, FONT_BOLD,
                UDim2.new(0,14,0,0))
            l.Size = UDim2.new(1,-80, desc and 0.55 or 1, 0)
            if desc then
                local d = mkLabel(el, desc, 11, DIM, FONT,
                    UDim2.new(0,14,0.55,0))
                d.Size = UDim2.new(1,-80,0.45,0)
            end
            local track = mkFrame(el, state and ACCENT or PENDING,
                UDim2.new(0,44,0,24),
                UDim2.new(1,-58,0.5,0), Vector2.new(0,0.5))
            corner(track, 12)
            local thumb = mkFrame(track, TEXT,
                UDim2.new(0,18,0,18),
                UDim2.new(state and 1 or 0, state and -21 or 3, 0.5,0),
                Vector2.new(0,0.5))
            corner(thumb, 9)

            local function update(v)
                state = v
                tw(track, {BackgroundColor3 = state and ACCENT or PENDING}, 0.2)
                tw(thumb, {Position = UDim2.new(state and 1 or 0, state and -21 or 3, 0.5,0)}, 0.2)
                if callback then pcall(callback, state) end
            end

            local overlay = Instance.new("TextButton")
            overlay.Size            = UDim2.new(1,0,1,0)
            overlay.BackgroundTransparency = 1
            overlay.Text            = ""
            overlay.Parent          = el
            overlay.MouseButton1Click:Connect(function() update(not state) end)

            return {
                Set = function(_, v) update(v) end,
                Get = function() return state end,
            }
        end

        function TabAPI:Slider(text, desc, min, max, default, callback)
