local function tw(obj, props, t, style, dir)
    TweenService:Create(obj,
        TweenInfo.new(t or 0.3,
            style or Enum.EasingStyle.Quart,
            dir   or Enum.EasingDirection.Out),
        props):Play()
end

local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = obj
    return c
end

local function stroke(obj, color, thick, trans)
    local s = Instance.new("UIStroke")
    s.Color      = color or DIVIDER
    s.Thickness  = thick or 1
    s.Transparency = trans or 0.5
    s.Parent     = obj
    return s
end

local function mkFrame(parent, bg, size, pos, anch)
    local f = Instance.new("Frame")
    f.BackgroundColor3 = bg or BG
    f.Size       = size or UDim2.new(1,0,1,0)
    f.Position   = pos  or UDim2.new(0,0,0,0)
    f.AnchorPoint= anch or Vector2.new(0,0)
    f.BorderSizePixel = 0
    f.Parent     = parent
    return f
end

local function mkLabel(parent, text, size, color, font, pos, anch)
    local l = Instance.new("TextLabel")
    l.Text            = text or ""
    l.TextSize        = size or 13
    l.TextColor3      = color or TEXT
    l.Font            = font or FONT
    l.BackgroundTransparency = 1
    l.Position        = pos  or UDim2.new(0,0,0,0)
    l.AnchorPoint     = anch or Vector2.new(0,0)
    l.TextXAlignment  = Enum.TextXAlignment.Left
    l.TextYAlignment  = Enum.TextYAlignment.Center
    l.Parent          = parent
    return l
end

local function mkIco(parent, img, sz, color, pos, anch)
    local i = Instance.new("ImageLabel")
    i.BackgroundTransparency = 1
    i.Image       = img or ""
    i.ImageColor3 = color or TEXT
    i.Size        = UDim2.new(0, sz or 20, 0, sz or 20)
    i.Position    = pos  or UDim2.new(0,0,0,0)
    i.AnchorPoint = anch or Vector2.new(0,0)
    i.ScaleType   = Enum.ScaleType.Fit
    i.Parent      = parent
    return i
end

local function divider(parent, y, xPad)
    xPad = xPad or 0
    local d = mkFrame(parent, DIVIDER,
        UDim2.new(1,-xPad*2,0,1),
        UDim2.new(0,xPad,0,y))
    d.BackgroundTransparency = 0.55
    return d
end

local function makeDrag(frame, handle)
    local dragging, dragInput, dragStart, startPos
    handle.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = inp.Position
            startPos  = frame.Position
            inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = inp
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if inp == dragInput and dragging then
            local d = inp.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

local function formatTime12()
    local h = tonumber(os.date("%H"))
    local m = os.date("%M")
    local s = os.date("%S")
    local ap = h >= 12 and "PM" or "AM"
    h = h % 12; if h == 0 then h = 12 end
    return string.format("%d:%s:%s %s", h, m, s, ap)
end

local function formatDate()
    return os.date("%b %d, %Y")
end

local function getExecutorName()
    if identifyexecutor then
        local ok, n = pcall(identifyexecutor)
        if ok and n then return n end
    end
    if getexecutorname then
        local ok, n = pcall(getexecutorname)
        if ok and n then return n end
    end
    if syn then return "Synapse X" end
    if KRNL_LOADED then return "KRNL" end
    return "Unknown"
end

local function getDeviceType()
    if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
        return "Mobile"
    elseif UserInputService.GamepadEnabled then
        return "Console"
    end
    return "PC"
end

local function getHWID()
    local ok, id = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    if ok and id and id ~= "" then return id end
    return tostring(LocalPlayer.UserId) .. "-" .. tostring(game.PlaceId)
end

local function saveKey(filename, key)
    if writefile then pcall(writefile, filename .. ".txt", key) end
end

local function loadSavedKey(filename)
    if readfile and isfile then
        local ok, v = pcall(function()
            if isfile(filename .. ".txt") then return readfile(filename .. ".txt") end
        end)
        if ok and v and v ~= "" then return v end
    end
    return nil
end

local function validateKey(cfg, key)
    if cfg.OnVerify then
        local ok, r = pcall(cfg.OnVerify, key)
        if not ok then return false, "Validation error" end
        if type(r) == "boolean" then
            return r, r and "Welcome back!" or "Invalid key"
        end
        if type(r) == "table" then
            return r.valid == true, r.message or (r.valid and "Welcome back!" or (r.error or "Invalid key"))
        end
        return false, "Bad validator response"
    elseif cfg.Provider == "platoboost" and cfg.WhitelistId and cfg.WhitelistId ~= "" then
        local ok, res = pcall(game.HttpGet, game,
            "https://api.platoboost.com/v1/authenticate/" .. cfg.WhitelistId .. "/" .. key)
        if ok and res then
            local d; pcall(function() d = HttpService:JSONDecode(res) end)
            if d then return d.status == true, d.status and "Welcome back!" or "Invalid key" end
        end
        return false, "Network error"
    end
    return false, "No validator configured"
end

local function mkCloseX(parent, onClose)
    local btn = Instance.new("ImageButton")
    btn.Size            = UDim2.new(0,20,0,20)
    btn.Position        = UDim2.new(1,-12,0.5,0)
    btn.AnchorPoint     = Vector2.new(1,0.5)
    btn.BackgroundTransparency = 1
    btn.Image           = Icons.close
    btn.ImageColor3     = DIM
    btn.Parent          = parent
    btn.MouseEnter:Connect(function()  btn.ImageColor3 = ERROR_COL end)
    btn.MouseLeave:Connect(function()  btn.ImageColor3 = DIM       end)
    btn.MouseButton1Click:Connect(onClose)
    return btn
end

local function CreateChangelogPanel(mainFrame, panelH, panelW, gap)
    local panel = mkFrame(mainFrame, HEADER,
        UDim2.new(0,0,0,panelH),
        UDim2.new(1,gap,0,0))
    panel.ClipsDescendants = true
    corner(panel, 10)
    local sk = stroke(panel, DIVIDER, 1, 1)

    local hdr = mkFrame(panel, HEADER, UDim2.new(1,0,0,46))
    mkIco(hdr, Icons.changelog, 16, ACCENT, UDim2.new(0,12,0.5,0), Vector2.new(0,0.5))
    local tl = mkLabel(hdr, "Changelog", 12, TEXT, FONT_BOLD,
        UDim2.new(0,34,0.5,0), Vector2.new(0,0.5))
    tl.Size = UDim2.new(1,-60,0,18)
    divider(hdr, 45, 0)

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size       = UDim2.new(1,0,1,-50)
    scroll.Position   = UDim2.new(0,0,0,50)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 2
    scroll.ScrollBarImageColor3 = ACCENT
    scroll.CanvasSize = UDim2.new(0,0,0,0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.BorderSizePixel = 0
    scroll.Parent = panel

    local ll = Instance.new("UIListLayout")
    ll.Padding     = UDim.new(0,0)
    ll.SortOrder   = Enum.SortOrder.LayoutOrder
    ll.Parent      = scroll
    local pp = Instance.new("UIPadding")
    pp.PaddingLeft  = UDim.new(0,14)
    pp.PaddingRight = UDim.new(0,14)
    pp.PaddingTop   = UDim.new(0,8)
    pp.Parent       = scroll

    local isOpen = false

    local function close()
        isOpen = false
        tw(sk, {Transparency=1}, 0.2)
        tw(panel, {Size=UDim2.new(0,0,0,panelH)}, 0.28,
            Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    end

    local function open()
        isOpen = true
        tw(sk, {Transparency=0.4}, 0.2)
        tw(panel, {Size=UDim2.new(0,panelW,0,panelH)}, 0.4)
    end

    mkCloseX(hdr, close)

    local function toggle()
        if isOpen then close() else open() end
    end

    local function refresh(entries)
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        entries = entries or {}
        if #entries == 0 then return end
        for idx, entry in ipairs(entries) do
            local ef = mkFrame(scroll, BG, UDim2.new(1,0,0,0))
            ef.BackgroundTransparency = 1
            ef.AutomaticSize = Enum.AutomaticSize.Y
            ef.LayoutOrder   = idx

            local vl = mkLabel(ef, entry.Version or "v?", 11, ACCENT, FONT_BOLD)
            vl.Size = UDim2.new(0.5,0,0,18)
            local dl = mkLabel(ef, entry.Date or "", 10, DIM, FONT,
                UDim2.new(1,0,0,0), Vector2.new(1,0))
            dl.Size = UDim2.new(0.5,0,0,18)
            dl.TextXAlignment = Enum.TextXAlignment.Right

            local changes = entry.Changes or {}
            local oy = 20
            for _, ch in ipairs(changes) do
                local cl = mkLabel(ef, "• " .. ch, 10, DIM, FONT, UDim2.new(0,0,0,oy))
                cl.Size = UDim2.new(1,0,0,15)
                cl.TextWrapped = true
                oy = oy + 15
            end
            ef.Size = UDim2.new(1,0,0,oy+6)

            if idx < #entries then
                local dv = mkFrame(ef, DIVIDER, UDim2.new(1,0,0,1), UDim2.new(0,0,0,oy+2))
                dv.BackgroundTransparency = 0.65
            end
        end
    end

    return panel, toggle, function() return isOpen end, refresh
end

