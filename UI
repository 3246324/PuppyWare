            local knob = mkFrame(el, TEXT, UDim2.new(0,14,0,14))
            corner(knob, 7)
            task.defer(function()
                local rel = (val-min)/(max-min)
                local ew  = el.AbsoluteSize.X
                knob.Position = UDim2.new(0, 14 + rel*(ew-28) - 7, 0, 38)
            end)

            local dragging = false
            local function update(x)
                local tw2 = track.AbsoluteSize.X
                if tw2 <= 0 then return end
                local rel = math.clamp((x - track.AbsolutePosition.X) / tw2, 0, 1)
                val = math.floor(min + rel*(max-min) + 0.5)
                valL.Text = tostring(val)
                fill.Size = UDim2.new(rel,0,1,0)
                local ew  = el.AbsoluteSize.X
                knob.Position = UDim2.new(0, 14 + rel*(ew-28) - 7, 0, 38)
                if callback then pcall(callback, val) end
            end

            knob.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
                    update(inp.Position.X)
                end
            end)
            track.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    update(inp.Position.X)
                end
            end)

            return {
                Set = function(_, v)
                    local tw2 = track.AbsoluteSize.X
                    if tw2 > 0 then
                        update(track.AbsolutePosition.X + (v-min)/(max-min)*tw2)
                    end
                end,
                Get = function() return val end,
            }
        end

        function TabAPI:Dropdown(text, options, default, callback)
            options  = options or {}
            local selected = default or options[1] or "Select..."
            local open     = false
            local el = elem(44)
            el.ClipsDescendants = false
            el.ZIndex = 10

            local l = mkLabel(el, text, 13, TEXT, FONT_BOLD,
                UDim2.new(0,14,0.5,-9))
            l.Size = UDim2.new(0.46,0,0,18)

            local dropBtn = Instance.new("TextButton")
            dropBtn.Size            = UDim2.new(0.54,-14,0,28)
            dropBtn.Position        = UDim2.new(0.46,0,0.5,0)
            dropBtn.AnchorPoint     = Vector2.new(0,0.5)
            dropBtn.BackgroundColor3= HEADER
            dropBtn.Text            = selected
            dropBtn.TextColor3      = TEXT
            dropBtn.Font            = FONT
            dropBtn.TextSize        = 12
            dropBtn.TextTruncate    = Enum.TextTruncate.AtEnd
            dropBtn.ZIndex          = 10
            dropBtn.Parent          = el
            corner(dropBtn, 6)
            stroke(dropBtn, DIVIDER, 1, 0.5)

            local arrow = mkLabel(dropBtn, "▾", 11, DIM, FONT_BOLD,
                UDim2.new(1,-6,0.5,0), Vector2.new(1,0.5))
            arrow.Size = UDim2.new(0,14,1,0)
            arrow.TextXAlignment = Enum.TextXAlignment.Right

            local listF = mkFrame(el, HEADER,
                UDim2.new(0.54,-14,0,0),
                UDim2.new(0.46,0,1,2))
            listF.ClipsDescendants = true
            listF.ZIndex           = 20
            corner(listF, 6)
            stroke(listF, DIVIDER, 1, 0.3)

            local lll = Instance.new("UIListLayout")
            lll.SortOrder = Enum.SortOrder.LayoutOrder
            lll.Parent    = listF
            local llp = Instance.new("UIPadding")
            llp.PaddingAll = UDim.new(0,4)
            llp.Parent     = listF

            for _, opt in ipairs(options) do
                local ob = Instance.new("TextButton")
                ob.Size            = UDim2.new(1,0,0,26)
                ob.BackgroundColor3= HEADER
                ob.Text            = "  " .. opt
                ob.TextColor3      = TEXT
                ob.Font            = FONT
                ob.TextSize        = 12
                ob.TextXAlignment  = Enum.TextXAlignment.Left
                ob.ZIndex          = 21
                ob.Parent          = listF
                corner(ob, 4)
                ob.MouseEnter:Connect(function()  tw(ob,{BackgroundColor3=INPUT},0.1) end)
                ob.MouseLeave:Connect(function()  tw(ob,{BackgroundColor3=HEADER},0.1) end)
                ob.MouseButton1Click:Connect(function()
                    selected = opt
                    dropBtn.Text = opt
                    open = false
                    tw(listF,{Size=UDim2.new(0.54,-14,0,0)},0.2)
                    tw(arrow,{Rotation=0},0.2)
                    if callback then pcall(callback, opt) end
                end)
            end

            dropBtn.MouseButton1Click:Connect(function()
                open = not open
                local h = open and math.min(#options*26+8, 158) or 0
                tw(listF,{Size=UDim2.new(0.54,-14,0,h)},0.2)
                tw(arrow,{Rotation=open and 180 or 0},0.2)
            end)

            return {
                Get = function() return selected end,
                Set = function(_, v) selected = v; dropBtn.Text = v end,
            }
        end

        function TabAPI:Keybind(text, default, callback)
            local bound    = default or Enum.KeyCode.Unknown
            local listening= false
            local el = elem(44)

            local l = mkLabel(el, text, 13, TEXT, FONT_BOLD,
                UDim2.new(0,14,0.5,0), Vector2.new(0,0.5))
            l.Size = UDim2.new(0.6,0,1,0)

            local kBtn = Instance.new("TextButton")
            kBtn.Size            = UDim2.new(0,76,0,28)
            kBtn.Position        = UDim2.new(1,-10,0.5,0)
            kBtn.AnchorPoint     = Vector2.new(1,0.5)
            kBtn.BackgroundColor3= INPUT
            kBtn.Text            = bound.Name
            kBtn.TextColor3      = ACCENT
            kBtn.Font            = FONT_BOLD
            kBtn.TextSize        = 11
            kBtn.Parent          = el
            corner(kBtn, 6)
            stroke(kBtn, DIVIDER, 1, 0.5)

            kBtn.MouseButton1Click:Connect(function()
                listening       = true
                kBtn.Text       = "..."
                kBtn.TextColor3 = DIM
            end)
            UserInputService.InputBegan:Connect(function(inp, gp)
                if gp then return end
                if listening and inp.UserInputType == Enum.UserInputType.Keyboard then
                    bound           = inp.KeyCode
                    kBtn.Text       = bound.Name
                    kBtn.TextColor3 = ACCENT
                    listening       = false
                elseif not listening and inp.KeyCode == bound then
                    if callback then pcall(callback) end
                end
            end)

            return {
                Get = function() return bound end,
                Set = function(_, k) bound = k; kBtn.Text = k.Name end,
            }
        end

        function TabAPI:Textbox(text, placeholder, callback)
            local el = elem(44)
            local l = mkLabel(el, text, 13, TEXT, FONT_BOLD,
                UDim2.new(0,14,0.5,0), Vector2.new(0,0.5))
            l.Size = UDim2.new(0.4,0,1,0)

            local iFrame = mkFrame(el, HEADER,
                UDim2.new(0.6,-14,0,28),
                UDim2.new(0.4,0,0.5,0), Vector2.new(0,0.5))
            corner(iFrame, 6)
            local iSk = stroke(iFrame, DIVIDER, 1, 0.5)

            local box = Instance.new("TextBox")
            box.Size            = UDim2.new(1,-16,1,0)
            box.Position        = UDim2.new(0,8,0,0)
            box.BackgroundTransparency = 1
            box.TextColor3      = TEXT
            box.PlaceholderText = placeholder or ""
            box.PlaceholderColor3 = DIM
            box.Font            = FONT
            box.TextSize        = 12
            box.ClearTextOnFocus= false
            box.Parent          = iFrame
            box.Focused:Connect(function()
                tw(iSk,{Color=ACCENT,Transparency=0.3},0.2)
            end)
            box.FocusLost:Connect(function(enter)
                tw(iSk,{Color=DIVIDER,Transparency=0.5},0.2)
                if enter and callback then pcall(callback, box.Text) end
            end)

            return {
                Get = function() return box.Text end,
                Set = function(_, v) box.Text = v end,
            }
        end

        return TabAPI
    end

    return WindowAPI
end

return Library.new()
