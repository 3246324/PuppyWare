local Library = {}
Library.__index = Library

function Library.new()
    local gui = game:GetService("CoreGui"):FindFirstChild("PuppyWareUI")
    if gui then gui:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name              = "PuppyWareUI"
    sg.ResetOnSpawn      = false
    sg.ZIndexBehavior    = Enum.ZIndexBehavior.Sibling
    sg.IgnoreGuiInset    = true
    if syn and syn.protect_gui then syn.protect_gui(sg) end
    sg.Parent = game:GetService("CoreGui")

    return setmetatable({_gui = sg}, Library)
end

function Library:KeySystem(cfg)
    cfg = cfg or {}

    if cfg.Keyless == true and cfg.KeylessUI == false then
        getgenv().SCRIPT_KEY = "KEYLESS"
        return true
    end

    local hui = mkFrame(self._gui, BG, UDim2.new(1,0,1,0))
    hui.BackgroundTransparency = 1

    local validated = false
    local done      = false

    BuildKeySystem(cfg, hui,
        function() validated = true; done = true end,
        function() getgenv().ArqelClosed = true; done = true end)

    repeat task.wait(0.1) until done
    return validated
end

function Library:Launch(cfg)
    cfg = cfg or {}
    local ok = self:KeySystem(cfg)
    if not ok then return nil end
    return self:Window(cfg)
end

