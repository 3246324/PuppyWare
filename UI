local function CreateChangelogPanel(mainFrame, panelH, panelW, gap)
    -- Panel sits to the RIGHT of mainFrame (parent = mainFrame, clips disabled)
    local panel = mkFrame(mainFrame, HEADER,
        UDim2.new(0, 0, 0, panelH),
        UDim2.new(1, gap, 0, 0))
    panel.ClipsDescendants = true
    corner(panel, 10)
    local pStroke = uiStroke(panel, DIVIDER, 1, 1)

    -- Header bar
    local hbar = mkFrame(panel, HEADER, UDim2.new(1,0,0,46))
    local htitle = mkLabel(hbar, "Changelog", 12, TEXT, FONT_BOLD,
        UDim2.new(0,14,0,0))
    htitle.Size = UDim2.new(1,-28,1,0)
    mkFrame(hbar, DIVIDER, UDim2.new(1,-24,0,1), UDim2.new(0,12,1,-1))

    -- Scroll
    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1,0,1,-50)
    scroll.Position = UDim2.new(0,0,0,50)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 2
    scroll.ScrollBarImageColor3 = ACCENT
    scroll.CanvasSize = UDim2.new(0,0,0,0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.BorderSizePixel = 0
    scroll.Parent = panel

    local ll = Instance.new("UIListLayout")
    ll.Padding = UDim.new(0,0)
    ll.SortOrder = Enum.SortOrder.LayoutOrder
    ll.Parent = scroll

    local pp = Instance.new("UIPadding")
    pp.PaddingLeft = UDim.new(0,12)
    pp.PaddingRight = UDim.new(0,12)
    pp.PaddingTop = UDim.new(0,8)
    pp.Parent = scroll

    local isOpen = false

    local function refresh(entries)
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        entries = entries or {}
        if #entries == 0 then
            local ef = mkFrame(scroll, BG, UDim2.new(1,0,0,36))
            ef.BackgroundTransparency = 1
            local el = mkLabel(ef, "No entries", 11, DIM, FONT,
                UDim2.new(0.5,0,0.5,0), Vector2.new(0.5,0.5))
            el.Size = UDim2.new(1,0,1,0)
            el.TextXAlignment = Enum.TextXAlignment.Center
            return
        end
        for _, entry in ipairs(entries) do
            local ef = mkFrame(scroll, BG, UDim2.new(1,-12,0,0))
            ef.BackgroundTransparency = 1
            ef.AutomaticSize = Enum.AutomaticSize.Y

            local vrow = mkFrame(ef, BG, UDim2.new(1,0,0,20))
            vrow.BackgroundTransparency = 1
            local vl = mkLabel(vrow, entry.Version or "v?", 11, ACCENT, FONT_BOLD)
            vl.Size = UDim2.new(0.6,0,1,0)
            local dl = mkLabel(vrow, entry.Date or "", 10, DIM, FONT,
                UDim2.new(1,0,0,0), Vector2.new(1,0))
            dl.Size = UDim2.new(0.4,0,1,0)
            dl.TextXAlignment = Enum.TextXAlignment.Right

            local changes = entry.Changes or {}
            local oy = 22
            for _, ch in ipairs(changes) do
                local cl = mkLabel(ef, "• "..ch, 11, DIM, FONT,
                    UDim2.new(0,0,0,oy))
                cl.Size = UDim2.new(1,0,0,16)
                cl.TextXAlignment = Enum.TextXAlignment.Left
                cl.TextWrapped = true
                oy = oy + 16
            end
            ef.Size = UDim2.new(1,-12,0,oy+8)

            local dv = mkFrame(ef, DIVIDER, UDim2.new(1,0,0,1),
                UDim2.new(0,0,0,oy+4))
            dv.BackgroundTransparency = 0.7
        end
    end

    local function toggle()
        isOpen = not isOpen
        if isOpen then
            tw(pStroke, {Transparency=0.4}, 0.2)
            tw(panel, {Size=UDim2.new(0,panelW,0,panelH)}, 0.4)
        else
            tw(pStroke, {Transparency=1}, 0.2)
            tw(panel, {Size=UDim2.new(0,0,0,panelH)}, 0.3,
                Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        end
    end

    return panel, toggle, function() return isOpen end, refresh
end

